<!doctype html>
<html lang="de">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ 'app.mail.order.confirmation.provisional.title'|trans }}</title></head>
<body style="margin:0; padding:0; background-color:{{ EMAIL_THEME.pageBackground }}; font-family:Arial,Helvetica,sans-serif; color:{{ EMAIL_THEME.text }};"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%; background-color:{{ EMAIL_THEME.pageBackground }};"><tr><td align="center" style="padding:24px 12px;"><table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%; max-width:600px; background-color:{{ EMAIL_THEME.surface }}; border:1px solid {{ EMAIL_THEME.outline }}; border-radius:20px;">
    <tr><td style="padding:32px 32px 18px 32px; text-align:center; background-color:{{ EMAIL_THEME.primaryContainer }};"><table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin:0 auto 22px auto;"><tr><td align="center"><img src="{{ LOGO_CID }}" width="210" alt="Gärngschee" style="display:block; width:210px; max-width:100%; height:auto;"></td></tr></table><h1 style="margin:0; font-size:28px; line-height:1.2; font-weight:700; color:{{ EMAIL_THEME.text }};">{{ 'app.mail.order.confirmation.provisional.title'|trans }}</h1></td></tr>
      <tr><td style="padding:0 32px 8px 32px; text-align:center;"><p style="margin:0 0 14px 0; font-size:18px; line-height:1.5; color:{{ EMAIL_THEME.text }};"><strong style="color:{{ EMAIL_THEME.success }};">{{ 'app.mail.order.confirmation.provisional.highlight'|trans({'%year%': ORDER.year}) }}</strong></p><p style="margin:0; font-size:17px; line-height:1.55; color:{{ EMAIL_THEME.mutedText }};">{{ 'app.mail.order.confirmation.provisional.body'|trans({'%year%': ORDER.year}) }}</p></td></tr>
       <tr><td style="padding:24px 32px 8px 32px;"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%; background-color:{{ EMAIL_THEME.warningContainer }}; border:1px solid {{ EMAIL_THEME.outline }}; border-radius:14px;"><tr><td style="padding:18px;">{% if ORDER.fairgateStatus|default('') == 'expired' %}<p style="margin:0 0 6px 0; font-size:16px; line-height:1.4; font-weight:700; color:{{ EMAIL_THEME.text }};">{{ 'app.mail.order.confirmation.provisional.expiredTitle'|trans }}</p><p style="margin:0; font-size:16px; line-height:1.5; color:{{ EMAIL_THEME.mutedText }};">{{ 'app.mail.order.confirmation.provisional.expiredText'|trans }}</p>{% if ORDER.fairgateDocumentEmail|default(null) %}<p style="margin:14px 0 0 0; font-size:16px; line-height:1.5;"><a href="mailto:{{ ORDER.fairgateDocumentEmail }}" style="color:{{ EMAIL_THEME.primary }};">{{ ORDER.fairgateDocumentEmail }}</a></p>{% endif %}{% else %}<p style="margin:0 0 6px 0; font-size:16px; line-height:1.4; font-weight:700; color:{{ EMAIL_THEME.text }};">{{ 'app.mail.order.confirmation.provisional.fairgateTitle'|trans }}</p><p style="margin:0; font-size:16px; line-height:1.5; color:{{ EMAIL_THEME.mutedText }};">{{ 'app.mail.order.confirmation.provisional.fairgateText'|trans({'%YEAR%': ORDER.year}) }}</p><p style="margin:14px 0 0 0; font-size:16px; line-height:1.5;"><a href="{{ ORDER.fairgateUrl }}" style="color:{{ EMAIL_THEME.primary }};">{{ 'app.mail.order.confirmation.provisional.fairgateLink'|trans }}</a></p>{% endif %}</td></tr></table></td></tr>
    <tr><td style="padding:18px 32px 34px 32px;"><h2 style="margin:0 0 12px 0; font-size:21px; line-height:1.3; color:{{ EMAIL_THEME.text }};">{{ 'app.mail.order.confirmation.provisional.overviewTitle'|trans }}</h2><p style="margin:0 0 14px 0; font-size:16px; line-height:1.5; color:{{ EMAIL_THEME.mutedText }};">{{ 'app.mail.order.confirmation.provisional.year'|trans }} <strong>{{ ORDER.year }}</strong><br>{{ 'app.mail.order.confirmation.provisional.adults'|trans }} <strong>{{ ORDER.adultsCount }}</strong><br>{{ 'app.mail.order.confirmation.provisional.children'|trans }} <strong>{{ ORDER.childrenCount }}</strong></p></td></tr>
</table></td></tr></table></body>
</html>
