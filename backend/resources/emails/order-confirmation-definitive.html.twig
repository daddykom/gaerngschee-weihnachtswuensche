<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ 'app.mail.order.confirmation.definitive.title'|trans }}</title>
</head>
<body style="margin:0; padding:0; background-color:{{ EMAIL_THEME.pageBackground }}; font-family:Arial,Helvetica,sans-serif; color:{{ EMAIL_THEME.text }};">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%; background-color:{{ EMAIL_THEME.pageBackground }};">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%; max-width:600px; table-layout:fixed; background-color:{{ EMAIL_THEME.surface }}; border:1px solid {{ EMAIL_THEME.outline }}; border-radius:20px;">
          <tr>
            <td style="padding:32px; text-align:center; background-color:{{ EMAIL_THEME.primaryContainer }};">
              <img src="{{ LOGO_CID }}" width="210" alt="Gärngschee" style="display:block; width:210px; max-width:100%; height:auto; margin:0 auto 22px auto;">
              <h1 style="margin:0; font-size:28px; line-height:1.2; font-weight:700;">{{ 'app.mail.order.confirmation.definitive.title'|trans }}</h1>
            </td>
          </tr>
          <tr>
            <td style="padding:24px 32px 32px 32px; font-size:17px; line-height:1.55; overflow-wrap:anywhere;">
              <p style="margin:0 0 18px 0;">{{ 'app.mail.order.confirmation.definitive.body'|trans({'%number%': ORDER.orderNumber, '%year%': ORDER.year}) }}</p>
              <p style="margin:0 0 18px 0;">{{ 'app.mail.order.confirmation.definitive.reserveTime'|trans }}</p>
              <p style="margin:0 0 18px 0;"><strong>{{ 'app.mail.pickup.dateLabel'|trans }}</strong><br>{{ PICKUP_DATE|e|nl2br }}</p>
              <p style="margin:0 0 18px 0;"><strong>{{ 'app.mail.pickup.locationLabel'|trans }}</strong><br>{{ PICKUP_LOCATION|e|nl2br }}</p>
              <p style="margin:0;">{{ 'app.mail.order.confirmation.definitive.nextText'|trans }}</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
