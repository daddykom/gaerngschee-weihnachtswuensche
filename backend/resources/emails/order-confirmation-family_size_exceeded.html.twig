<!doctype html>
<html lang="de">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ 'app.mail.order.confirmation.family_size_exceeded.title'|trans }}</title></head>
<body style="margin:0; padding:0; background-color:{{ EMAIL_THEME.pageBackground }}; font-family:Arial,Helvetica,sans-serif; color:{{ EMAIL_THEME.text }};"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%; background-color:{{ EMAIL_THEME.pageBackground }};"><tr><td align="center" style="padding:24px 12px;"><table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%; max-width:600px; background-color:{{ EMAIL_THEME.surface }}; border:1px solid {{ EMAIL_THEME.outline }}; border-radius:20px;">
<tr><td style="padding:32px 32px 18px 32px; text-align:center; background-color:{{ EMAIL_THEME.primaryContainer }};"><table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin:0 auto 22px auto;"><tr><td align="center"><img src="{{ LOGO_CID }}" width="210" alt="Gärngschee" style="display:block; width:210px; max-width:100%; height:auto;"></td></tr></table><h1 style="margin:0; font-size:28px; line-height:1.2; font-weight:700; color:{{ EMAIL_THEME.text }};">{{ 'app.mail.order.confirmation.family_size_exceeded.title'|trans }}</h1></td></tr>
<tr><td style="padding:24px 32px 8px 32px;"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%; background-color:{{ EMAIL_THEME.warningContainer }}; border:1px solid {{ EMAIL_THEME.outline }}; border-radius:14px;"><tr><td style="padding:18px;"><p style="margin:0 0 6px 0; font-size:16px; line-height:1.4; font-weight:700; color:{{ EMAIL_THEME.text }};">{{ 'app.mail.order.confirmation.family_size_exceeded.noticeTitle'|trans }}</p><p style="margin:0; font-size:16px; line-height:1.5; color:{{ EMAIL_THEME.mutedText }};">{{ 'app.mail.order.confirmation.family_size_exceeded.noticeText'|trans }}</p></td></tr></table></td></tr>
<tr><td style="padding:18px 32px 8px 32px;"><p style="margin:0; font-size:16px; line-height:1.5; color:{{ EMAIL_THEME.mutedText }};">{{ 'app.mail.order.confirmation.family_size_exceeded.counts'|trans({'%orderAdults%': ORDER.adultsCount, '%orderChildren%': ORDER.childrenCount, '%fairgateAdults%': ORDER.fairgateAdultsCount, '%fairgateChildren%': ORDER.fairgateChildrenCount}) }}</p><p style="margin:18px 0 0 0; font-size:16px; line-height:1.5;"><a href="{{ ORDER.startUrl }}" style="display:inline-block; padding:12px 18px; border-radius:999px; background-color:{{ EMAIL_THEME.primary }}; color:{{ EMAIL_THEME.onPrimary }}; font-weight:700; text-decoration:none;">{{ 'app.mail.order.confirmation.family_size_exceeded.button'|trans }}</a></p></td></tr>
<tr><td style="padding:18px 32px 34px 32px;"><p style="margin:0; font-size:14px; line-height:1.5; color:{{ EMAIL_THEME.mutedText }};">{{ 'app.mail.order.confirmation.family_size_exceeded.footer'|trans }}</p></td></tr>
</table></td></tr></table></body></html>
